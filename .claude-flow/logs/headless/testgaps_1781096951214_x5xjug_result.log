        "title": "`src/adapters/cache.ts` — No test file",
        "content": "\nThe only public API is the singleton `getModelCache()`. Critical missing scenario: it must return the **same instance** across calls (singleton contract).\n\n```typescript\n// tests/adapters/cache.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { getModelCache } from \"../../src/adapters/cache.js\";\nimport { InMemoryCache } from \"@langchain/core/caches\";\n\ndescribe(\"Model Cache Adapter\", () => {\n  it(\"returns an InMemoryCache instance\", () => {\n    const cache = getModelCache();\n    expect(cache).toBeInstanceOf(InMemoryCache);\n  });\n\n  it(\"returns the same singleton instance on every call\", () => {\n    const a = getModelCache();\n    const b = getModelCache();\n    expect(a).toBe(b); // referential equality — same object\n  });\n});\n```\n\n---\n\n",
        "level": 4
