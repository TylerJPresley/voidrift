      {
        "title": "`src/bootstrap/validate.ts` — No test file",
        "content": "\n`validateAssets` has three distinct code paths with no tests: missing metadata, missing frontmatter keys, dangling agent references. The `require(\"fs\")` inside the function also means a corrupted file path should be handled silently (bare `catch {}`).\n\n```typescript\n// tests/bootstrap/validate.test.ts\nimport { describe, it, expect, beforeEach, afterEach } from \"vitest\";\nimport { validateAssets } from \"../../src/bootstrap/validate.js\";\nimport { AgentRegistry } from \"../../src/agents/registry.js\";\nimport { mkdirSync, writeFileSync, rmSync } from \"fs\";\nimport { join } from \"path\";\nimport { tmpdir } from \"os\";\n\nconst TMP = join(tmpdir(), \"voidrift-validate-test-\" + Date.now());\n\nfunction makeSkillWithAgents(agents: string[], filePath: string, name = \"my-skill\", description = \"A skill\") {\n  return { name, description, agents, filePath, indexed: true, active: true } as any;\n}\n\nfunction makeSkillManager(skills: any[]) {\n  return { indexed: skills } as any;\n}\n\nafterEach(() => { rmSync(TMP, { recursive: true, force: true }); });\n\ndescribe(\"validateAssets\", () => {\n  it(\"returns no issues for an empty skill list\", () => {\n    const registry = new AgentRegistry();\n    const issues = validateAssets(registry, makeSkillManager([]));\n    expect(issues).toHaveLength(0);\n  });\n\n  it(\"flags skill missing name\", () => {\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([], \"/tmp/missing.md\", \"\", \"Has description\");\n    const issues = validateAssets(registry, makeSkillManager([skill]));\n    expect(issues).toHaveLength(1);\n    expect(issues[0].type).toBe(\"skill\");\n    expect(issues[0].message).toMatch(/Missing required name or description/);\n  });\n\n  it(\"flags skill missing description\", () => {\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([], \"/tmp/nodesc.md\", \"my-skill\", \"\");\n    const issues = validateAssets(registry, makeSkillManager([skill]));\n    expect(issues[0].message).toMatch(/Missing required name or description/);\n  });\n\n  it(\"flags skill with missing frontmatter keys\", () => {\n    mkdirSync(TMP, { recursive: true });\n    const skillPath = join(TMP, \"incomplete.md\");\n    // Missing all three required frontmatter keys\n    writeFileSync(skillPath, \"---\\nname: test\\ndescription: Test skill\\n---\\nBody\");\n\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([\"chat\"], skillPath, \"test\", \"Test skill\");\n    const issues = validateAssets(registry, makeSkillManager([skill]));\n    expect(issues).toHaveLength(1);\n    expect(issues[0].message).toMatch(/Missing required frontmatter keys/);\n    expect(issues[0].message).toContain(\"triggers\");\n    expect(issues[0].message).toContain(\"agents\");\n    expect(issues[0].message).toContain(\"active\");\n  });\n\n  it(\"does not flag a skill with all required frontmatter keys and valid agent refs\", () => {\n    mkdirSync(TMP, { recursive: true });\n    const skillPath = join(TMP, \"valid.md\");\n    writeFileSync(skillPath, \"---\\ntriggers: []\\nagents: [chat]\\nactive: true\\n---\\nBody\");\n\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([\"chat\"], skillPath, \"valid-skill\", \"Valid\");\n    const issues = validateAssets(registry, makeSkillManager([skill]));\n    expect(issues).toHaveLength(0);\n  });\n\n  it(\"flags skill referencing nonexistent agent id\", () => {\n    mkdirSync(TMP, { recursive: true });\n    const skillPath = join(TMP, \"dangling.md\");\n    writeFileSync(skillPath, \"---\\ntriggers: []\\nagents: [ghost-agent]\\nactive: true\\n---\\nBody\");\n\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([\"ghost-agent\"], skillPath, \"dangling-skill\", \"Dangling\");\n    const issues = validateAssets(registry, makeSkillManager([skill]));\n    expect(issues).toHaveLength(1);\n    expect(issues[0].message).toMatch(/nonexistent agent/);\n    expect(issues[0].message).toContain(\"ghost-agent\");\n  });\n\n  it(\"handles nonexistent skill file path silently (no crash)\", () => {\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([\"chat\"], \"/nonexistent/path/skill.md\", \"ghost\", \"Ghost skill\");\n    // Should not throw — the bare catch {} swallows the ENOENT\n    expect(() => validateAssets(registry, makeSkillManager([skill]))).not.toThrow();\n  });\n});\n```\n\n---\n\n",
        "level": 4
      },
      {
        "title": "`src/mcp/credentials.ts` — No test file",
        "content": "\nEncryption/decryption round-trip, CRUD lifecycle, and `refreshIfNeeded` expiry logic are all untested. The deterministic key derivation from `homedir()` means tests can run without mocking crypto.\n\n```typescript\n// tests/mcp/credentials.test.ts\nimport { describe, it, expect, afterEach } from \"vitest\";\nimport { saveCredential, loadCredential, deleteCredential, hasCredential, refreshIfNeeded } from \"../../src/mcp/credentials.js\";\nimport type { StoredCredential } from \"../../src/mcp/credentials.js\";\n\nconst TEST_SERVER = \"test-server-\" + Date.now();\n\nafterEach(() => {\n  deleteCredential(TEST_SERVER);\n});\n\nconst CRED: StoredCredential = {\n  accessToken: \"tok_abc123\",\n  refreshToken: \"ref_xyz789\",\n  tokenType: \"Bearer\",\n  scope: \"read write\",\n};\n\ndescribe(\"MCP Credential Store\", () => {\n  it(\"round-trips a credential through save and load\", () => {\n    saveCredential(TEST_SERVER, CRED);\n    const loaded = loadCredential(TEST_SERVER);\n    expect(loaded).not.toBeNull();\n    expect(loaded!.accessToken).toBe(\"tok_abc123\");\n    expect(loaded!.refreshToken).toBe(\"ref_xyz789\");\n    expect(loaded!.scope).toBe(\"read write\");\n  });\n\n  it(\"returns null for nonexistent server\", () => {\n    expect(loadCredential(\"server-that-does-not-exist\")).toBeNull();\n  });\n\n  it(\"hasCredential returns false before save, true after\", () => {\n    expect(hasCredential(TEST_SERVER)).toBe(false);\n    saveCredential(TEST_SERVER, CRED);\n    expect(hasCredential(TEST_SERVER)).toBe(true);\n  });\n\n  it(\"deleteCredential removes the credential file\", () => {\n    saveCredential(TEST_SERVER, CRED);\n    deleteCredential(TEST_SERVER);\n    expect(hasCredential(TEST_SERVER)).toBe(false);\n    expect(loadCredential(TEST_SERVER)).toBeNull();\n  });\n\n  it(\"deleteCredential is a no-op for nonexistent server\", () => {\n    expect(() => deleteCredential(\"never-existed-\" + Date.now())).not.toThrow();\n  });\n\n  it(\"overwrites existing credential on second save\", () => {\n    saveCredential(TEST_SERVER, CRED);\n    saveCredential(TEST_SERVER, { ...CRED, accessToken: \"tok_NEW\" });\n    const loaded = loadCredential(TEST_SERVER);\n    expect(loaded!.accessToken).toBe(\"tok_NEW\");\n  });\n});\n\ndescribe(\"refreshIfNeeded\", () => {\n  it(\"returns the credential unchanged when not expired\", async () => {\n    const cred: StoredCredential = {\n      accessToken: \"valid\",\n      expiresAt: Date.now() + 3600_000, // 1 hour from now\n    };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"http://unused.example.com\" } as any);\n    expect(result).toBe(cred); // same reference — no refresh\n  });\n\n  it(\"returns null when expired but no refreshToken\", async () => {\n    const cred: StoredCredential = {\n      accessToken: \"expired\",\n      expiresAt: Date.now() - 1000, // already expired\n    };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"http://unused.example.com\" } as any);\n    expect(result).toBeNull();\n  });\n\n  it(\"returns credential unchanged when expiresAt is undefined (no expiry)\", async () => {\n    const cred: StoredCredential = { accessToken: \"no-expiry\" };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"http://unused.example.com\" } as any);\n    expect(result).toBe(cred);\n  });\n});\n```\n\n---\n\n",
        "level": 4
      },
