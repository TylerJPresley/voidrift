        "code": "// Add to tests/adapters/factory.test.ts\n\nit(\"throws for unknown protocol\", () => {\n  const badConfig = { ...TEST_CONFIG, models: { ...TEST_CONFIG.models,\n    \"bad-proto\": { protocol: \"grpc\" as any, model: \"x\", baseUrl: \"http://x\", contextLimit: 1000, temperature: 0.2 },\n  }};\n  expect(() => createAdapter(\"bad-proto\", badConfig)).toThrow(/Unknown protocol/);\n});\n\nit(\"Anthropic uses 4096 default maxTokens when maxOutputTokens is not set\", () => {\n  const resolved = createAdapter(\"claude-opus\", TEST_CONFIG); // claude-opus has no maxOutputTokens\n  const client = resolved.client as any;\n  expect(client.maxTokens).toBe(4096);\n});\n\nit(\"Anthropic with non-anthropic baseUrl passes baseURL in clientOptions\", () => {\n  const proxyConfig: VoidRiftConfig = { ...TEST_CONFIG, models: { ...TEST_CONFIG.models,\n    \"claude-proxy\": { protocol: \"anthropic\", model: \"claude-3-5-sonnet-latest\",\n      baseUrl: \"https://my-proxy.internal/v1\", apiKeyEnv: \"ANTHROPIC_API_KEY\", contextLimit: 200000, temperature: 0.2 },\n  }};\n  const resolved = createAdapter(\"claude-proxy\", proxyConfig);\n  const client = resolved.client as any;\n  expect(client.clientOptions?.baseURL).toContain(\"my-proxy.internal\");\n});\n\nit(\"passes maxConcurrentAgents as maxConcurrency to clients\", () => {\n  const concConfig: VoidRiftConfig = { ...TEST_CONFIG, maxConcurrentAgents: 5 };\n  const resolved = createAdapter(\"local-qwen\", concConfig);\n  const client = resolved.client as any;\n  expect(client.maxConcurrency).toBe(5);\n});"
