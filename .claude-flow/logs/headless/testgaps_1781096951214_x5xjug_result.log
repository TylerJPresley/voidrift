        "title": "`src/codemap/summarizer.ts` — No test file",
        "content": "\nTwo untested paths: the small-file shortcut (returns content verbatim) and the Flash fallback when the model call fails.\n\n```typescript\n// tests/codemap/summarizer.test.ts\nimport { describe, it, expect, vi, afterEach } from \"vitest\";\nimport { summarizeFileWithFlash } from \"../../src/codemap/summarizer.js\";\nimport type { VoidRiftConfig } from \"../../src/config/loader.js\";\n\nconst CONFIG: VoidRiftConfig = {\n  tiers: { flash: \"local\", utility: \"local\", dense: \"local\" },\n  models: { local: { protocol: \"openai\", model: \"test-model\", baseUrl: \"http://localhost:11434/v1\", contextLimit: 32768, temperature: 0.2 } },\n  summarizeThreshold: 500,\n  maxReadLines: 1000,\n  maxConcurrentAgents: 1,\n  plugins: [],\n  search: { provider: \"duckduckgo\" },\n  tracing: { enabled: false, apiKeyEnv: \"LANGCHAIN_API_KEY\", project: \"voidrift\" },\n};\n\nafterEach(() => { vi.restoreAllMocks(); });\n\ndescribe(\"summarizeFileWithFlash\", () => {\n  it(\"returns full content verbatim for files under summarizeThreshold\", async () => {\n    const content = \"export function hello() {}\\n\".repeat(10); // well under 500 lines\n    const { summary, totalLines } = await summarizeFileWithFlash(\"src/hello.ts\", content, CONFIG);\n    expect(summary).toBe(content);\n    expect(totalLines).toBe(content.split(\"\\n\").length);\n  });\n\n  it(\"falls back to structural summary when Flash model call fails\", async () => {\n    vi.mock(\"../../src/adapters/factory.js\", () => ({\n      createTierAdapter: vi.fn().mockReturnValue({\n        client: { invoke: vi.fn().mockRejectedValue(new Error(\"model unavailable\")), cache: null },\n      }),\n    }));\n\n    const longContent = \"export function x() {}\\n\".repeat(600); // exceeds 500 line threshold\n    const { summary, totalLines } = await summarizeFileWithFlash(\"src/big.ts\", longContent, CONFIG);\n    expect(typeof summary).toBe(\"string\");\n    expect(summary.length).toBeGreaterThan(0);\n    expect(totalLines).toBe(600);\n  });\n\n  it(\"wraps Flash summary with path and line count header\", async () => {\n    vi.mock(\"../../src/adapters/factory.js\", () => ({\n      createTierAdapter: vi.fn().mockReturnValue({\n        client: { invoke: vi.fn().mockResolvedValue({ content: \"This file exports helpers.\" }), cache: null },\n      }),\n    }));\n\n    const longContent = \"export function helper() {}\\n\".repeat(600);\n    const { summary } = await summarizeFileWithFlash(\"src/helpers.ts\", longContent, CONFIG);\n    expect(summary).toContain(\"src/helpers.ts\");\n    expect(summary).toContain(\"lines\");\n    expect(summary).toContain(\"Flash summary\");\n  });\n});\n```\n\n---\n\n",
