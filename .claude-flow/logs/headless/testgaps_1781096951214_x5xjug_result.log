  "output": "Now I have enough to give a thorough analysis. Here's the complete coverage audit:\n\n---\n\n## Test Coverage Gaps\n\n### 1. Files with Zero Test Coverage\n\n#### `src/adapters/cache.ts` — No test file\n\nThe only public API is the singleton `getModelCache()`. Critical missing scenario: it must return the **same instance** across calls (singleton contract).\n\n```typescript\n// tests/adapters/cache.test.ts\nimport { describe, it, expect } from \"vitest\";\nimport { getModelCache } from \"../../src/adapters/cache.js\";\nimport { InMemoryCache } from \"@langchain/core/caches\";\n\ndescribe(\"Model Cache Adapter\", () => {\n  it(\"returns an InMemoryCache instance\", () => {\n    const cache = getModelCache();\n    expect(cache).toBeInstanceOf(InMemoryCache);\n  });\n\n  it(\"returns the same singleton instance on every call\", () => {\n    const a = getModelCache();\n    const b = getModelCache();\n    expect(a).toBe(b); // referential equality — same object\n  });\n});\n```\n\n---\n\n#### `src/bootstrap/validate.ts` — No test file\n\n`validateAssets` has three distinct code paths with no tests: missing metadata, missing frontmatter keys, dangling agent references. The `require(\"fs\")` inside the function also means a corrupted file path should be handled silently (bare `catch {}`).\n\n```typescript\n// tests/bootstrap/validate.test.ts\nimport { describe, it, expect, beforeEach, afterEach } from \"vitest\";\nimport { validateAssets } from \"../../src/bootstrap/validate.js\";\nimport { AgentRegistry } from \"../../src/agents/registry.js\";\nimport { mkdirSync, writeFileSync, rmSync } from \"fs\";\nimport { join } from \"path\";\nimport { tmpdir } from \"os\";\n\nconst TMP = join(tmpdir(), \"voidrift-validate-test-\" + Date.now());\n\nfunction makeSkillWithAgents(agents: string[], filePath: string, name = \"my-skill\", description = \"A skill\") {\n  return { name, description, agents, filePath, indexed: true, active: true } as any;\n}\n\nfunction makeSkillManager(skills: any[]) {\n  return { indexed: skills } as any;\n}\n\nafterEach(() => { rmSync(TMP, { recursive: true, force: true }); });\n\ndescribe(\"validateAssets\", () => {\n  it(\"returns no issues for an empty skill list\", () => {\n    const registry = new AgentRegistry();\n    const issues = validateAssets(registry, makeSkillManager([]));\n    expect(issues).toHaveLength(0);\n  });\n\n  it(\"flags skill missing name\", () => {\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([], \"/tmp/missing.md\", \"\", \"Has description\");\n    const issues = validateAssets(registry, makeSkillManager([skill]));\n    expect(issues).toHaveLength(1);\n    expect(issues[0].type).toBe(\"skill\");\n    expect(issues[0].message).toMatch(/Missing required name or description/);\n  });\n\n  it(\"flags skill missing description\", () => {\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([], \"/tmp/nodesc.md\", \"my-skill\", \"\");\n    const issues = validateAssets(registry, makeSkillManager([skill]));\n    expect(issues[0].message).toMatch(/Missing required name or description/);\n  });\n\n  it(\"flags skill with missing frontmatter keys\", () => {\n    mkdirSync(TMP, { recursive: true });\n    const skillPath = join(TMP, \"incomplete.md\");\n    // Missing all three required frontmatter keys\n    writeFileSync(skillPath, \"---\\nname: test\\ndescription: Test skill\\n---\\nBody\");\n\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([\"chat\"], skillPath, \"test\", \"Test skill\");\n    const issues = validateAssets(registry, makeSkillManager([skill]));\n    expect(issues).toHaveLength(1);\n    expect(issues[0].message).toMatch(/Missing required frontmatter keys/);\n    expect(issues[0].message).toContain(\"triggers\");\n    expect(issues[0].message).toContain(\"agents\");\n    expect(issues[0].message).toContain(\"active\");\n  });\n\n  it(\"does not flag a skill with all required frontmatter keys and valid agent refs\", () => {\n    mkdirSync(TMP, { recursive: true });\n    const skillPath = join(TMP, \"valid.md\");\n    writeFileSync(skillPath, \"---\\ntriggers: []\\nagents: [chat]\\nactive: true\\n---\\nBody\");\n\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([\"chat\"], skillPath, \"valid-skill\", \"Valid\");\n    const issues = validateAssets(registry, makeSkillManager([skill]));\n    expect(issues).toHaveLength(0);\n  });\n\n  it(\"flags skill referencing nonexistent agent id\", () => {\n    mkdirSync(TMP, { recursive: true });\n    const skillPath = join(TMP, \"dangling.md\");\n    writeFileSync(skillPath, \"---\\ntriggers: []\\nagents: [ghost-agent]\\nactive: true\\n---\\nBody\");\n\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([\"ghost-agent\"], skillPath, \"dangling-skill\", \"Dangling\");\n    const issues = validateAssets(registry, makeSkillManager([skill]));\n    expect(issues).toHaveLength(1);\n    expect(issues[0].message).toMatch(/nonexistent agent/);\n    expect(issues[0].message).toContain(\"ghost-agent\");\n  });\n\n  it(\"handles nonexistent skill file path silently (no crash)\", () => {\n    const registry = new AgentRegistry();\n    const skill = makeSkillWithAgents([\"chat\"], \"/nonexistent/path/skill.md\", \"ghost\", \"Ghost skill\");\n    // Should not throw — the bare catch {} swallows the ENOENT\n    expect(() => validateAssets(registry, makeSkillManager([skill]))).not.toThrow();\n  });\n});\n```\n\n---\n\n#### `src/mcp/credentials.ts` — No test file\n\nEncryption/decryption round-trip, CRUD lifecycle, and `refreshIfNeeded` expiry logic are all untested. The deterministic key derivation from `homedir()` means tests can run without mocking crypto.\n\n```typescript\n// tests/mcp/credentials.test.ts\nimport { describe, it, expect, afterEach } from \"vitest\";\nimport { saveCredential, loadCredential, deleteCredential, hasCredential, refreshIfNeeded } from \"../../src/mcp/credentials.js\";\nimport type { StoredCredential } from \"../../src/mcp/credentials.js\";\n\nconst TEST_SERVER = \"test-server-\" + Date.now();\n\nafterEach(() => {\n  deleteCredential(TEST_SERVER);\n});\n\nconst CRED: StoredCredential = {\n  accessToken: \"tok_abc123\",\n  refreshToken: \"ref_xyz789\",\n  tokenType: \"Bearer\",\n  scope: \"read write\",\n};\n\ndescribe(\"MCP Credential Store\", () => {\n  it(\"round-trips a credential through save and load\", () => {\n    saveCredential(TEST_SERVER, CRED);\n    const loaded = loadCredential(TEST_SERVER);\n    expect(loaded).not.toBeNull();\n    expect(loaded!.accessToken).toBe(\"tok_abc123\");\n    expect(loaded!.refreshToken).toBe(\"ref_xyz789\");\n    expect(loaded!.scope).toBe(\"read write\");\n  });\n\n  it(\"returns null for nonexistent server\", () => {\n    expect(loadCredential(\"server-that-does-not-exist\")).toBeNull();\n  });\n\n  it(\"hasCredential returns false before save, true after\", () => {\n    expect(hasCredential(TEST_SERVER)).toBe(false);\n    saveCredential(TEST_SERVER, CRED);\n    expect(hasCredential(TEST_SERVER)).toBe(true);\n  });\n\n  it(\"deleteCredential removes the credential file\", () => {\n    saveCredential(TEST_SERVER, CRED);\n    deleteCredential(TEST_SERVER);\n    expect(hasCredential(TEST_SERVER)).toBe(false);\n    expect(loadCredential(TEST_SERVER)).toBeNull();\n  });\n\n  it(\"deleteCredential is a no-op for nonexistent server\", () => {\n    expect(() => deleteCredential(\"never-existed-\" + Date.now())).not.toThrow();\n  });\n\n  it(\"overwrites existing credential on second save\", () => {\n    saveCredential(TEST_SERVER, CRED);\n    saveCredential(TEST_SERVER, { ...CRED, accessToken: \"tok_NEW\" });\n    const loaded = loadCredential(TEST_SERVER);\n    expect(loaded!.accessToken).toBe(\"tok_NEW\");\n  });\n});\n\ndescribe(\"refreshIfNeeded\", () => {\n  it(\"returns the credential unchanged when not expired\", async () => {\n    const cred: StoredCredential = {\n      accessToken: \"valid\",\n      expiresAt: Date.now() + 3600_000, // 1 hour from now\n    };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"http://unused.example.com\" } as any);\n    expect(result).toBe(cred); // same reference — no refresh\n  });\n\n  it(\"returns null when expired but no refreshToken\", async () => {\n    const cred: StoredCredential = {\n      accessToken: \"expired\",\n      expiresAt: Date.now() - 1000, // already expired\n    };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"http://unused.example.com\" } as any);\n    expect(result).toBeNull();\n  });\n\n  it(\"returns credential unchanged when expiresAt is undefined (no expiry)\", async () => {\n    const cred: StoredCredential = { accessToken: \"no-expiry\" };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"http://unused.example.com\" } as any);\n    expect(result).toBe(cred);\n  });\n});\n```\n\n---\n\n#### `src/mcp/discovery.ts` — No test file\n\n`discoverMCPServer` requires network calls, but `extractResourceMetadataUrl` and `buildConfigFromDiscovery` are pure and fully testable. The discovery function itself needs fetch mocking for error paths.\n\n```typescript\n// tests/mcp/discovery.test.ts\nimport { describe, it, expect, vi, afterEach } from \"vitest\";\nimport { discoverMCPServer, buildConfigFromDiscovery } from \"../../src/mcp/discovery.js\";\nimport type { MCPDiscoveryResult } from \"../../src/mcp/discovery.js\";\n\nafterEach(() => { vi.restoreAllMocks(); });\n\ndescribe(\"discoverMCPServer\", () => {\n  it(\"returns no-auth result when server responds without error\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue({\n      json: async () => ({ result: { protocolVersion: \"2024-11-05\", capabilities: {} } }),\n      ok: true,\n    }));\n\n    const result = await discoverMCPServer(\"http://localhost:9000\");\n    expect(result.requiresAuth).toBe(false);\n    expect(result.error).toBeUndefined();\n  });\n\n  it(\"records error when server returns non-auth error\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue({\n      json: async () => ({ error: { message: \"Internal Server Error\", data: {} } }),\n      ok: true,\n    }));\n\n    const result = await discoverMCPServer(\"http://localhost:9000\");\n    expect(result.error).toMatch(/Internal Server Error/);\n  });\n\n  it(\"captures discovery failure when fetch throws\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"ECONNREFUSED\")));\n\n    const result = await discoverMCPServer(\"http://localhost:9001\");\n    expect(result.error).toMatch(/Discovery failed/);\n    expect(result.error).toContain(\"ECONNREFUSED\");\n  });\n\n  it(\"calls onStatus callback with progress messages\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue({\n      json: async () => ({ result: { protocolVersion: \"2024-11-05\" } }),\n      ok: true,\n    }));\n\n    const statuses: string[] = [];\n    await discoverMCPServer(\"http://localhost:9000\", (msg) => statuses.push(msg));\n    expect(statuses.length).toBeGreaterThan(0);\n  });\n});\n\ndescribe(\"buildConfigFromDiscovery\", () => {\n  it(\"builds a basic http-sse config from no-auth discovery\", () => {\n    const discovery: MCPDiscoveryResult = {\n      url: \"http://localhost:9000\",\n      transport: \"http-sse\",\n      requiresAuth: false,\n    };\n    const config = buildConfigFromDiscovery(\"my-server\", discovery);\n    expect(config.transport).toBe(\"http-sse\");\n    expect(config.url).toBe(\"http://localhost:9000\");\n  });\n\n  it(\"includes auth config when discovery found OAuth\", () => {\n    const discovery: MCPDiscoveryResult = {\n      url: \"http://localhost:9000\",\n      transport: \"http-sse\",\n      requiresAuth: true,\n      authConfig: {\n        authorizeUrl: \"https://auth.example.com/authorize\",\n        tokenUrl: \"https://auth.example.com/token\",\n        scopes: [\"read\", \"write\"],\n      },\n    };\n    const config = buildConfigFromDiscovery(\"auth-server\", discovery);\n    expect(config).toMatchObject({\n      transport: \"http-sse\",\n      url: \"http://localhost:9000\",\n    });\n  });\n});\n```\n\n---\n\n#### `src/codemap/summarizer.ts` — No test file\n\nTwo untested paths: the small-file shortcut (returns content verbatim) and the Flash fallback when the model call fails.\n\n```typescript\n// tests/codemap/summarizer.test.ts\nimport { describe, it, expect, vi, afterEach } from \"vitest\";\nimport { summarizeFileWithFlash } from \"../../src/codemap/summarizer.js\";\nimport type { VoidRiftConfig } from \"../../src/config/loader.js\";\n\nconst CONFIG: VoidRiftConfig = {\n  tiers: { flash: \"local\", utility: \"local\", dense: \"local\" },\n  models: { local: { protocol: \"openai\", model: \"test-model\", baseUrl: \"http://localhost:11434/v1\", contextLimit: 32768, temperature: 0.2 } },\n  summarizeThreshold: 500,\n  maxReadLines: 1000,\n  maxConcurrentAgents: 1,\n  plugins: [],\n  search: { provider: \"duckduckgo\" },\n  tracing: { enabled: false, apiKeyEnv: \"LANGCHAIN_API_KEY\", project: \"voidrift\" },\n};\n\nafterEach(() => { vi.restoreAllMocks(); });\n\ndescribe(\"summarizeFileWithFlash\", () => {\n  it(\"returns full content verbatim for files under summarizeThreshold\", async () => {\n    const content = \"export function hello() {}\\n\".repeat(10); // well under 500 lines\n    const { summary, totalLines } = await summarizeFileWithFlash(\"src/hello.ts\", content, CONFIG);\n    expect(summary).toBe(content);\n    expect(totalLines).toBe(content.split(\"\\n\").length);\n  });\n\n  it(\"falls back to structural summary when Flash model call fails\", async () => {\n    vi.mock(\"../../src/adapters/factory.js\", () => ({\n      createTierAdapter: vi.fn().mockReturnValue({\n        client: { invoke: vi.fn().mockRejectedValue(new Error(\"model unavailable\")), cache: null },\n      }),\n    }));\n\n    const longContent = \"export function x() {}\\n\".repeat(600); // exceeds 500 line threshold\n    const { summary, totalLines } = await summarizeFileWithFlash(\"src/big.ts\", longContent, CONFIG);\n    expect(typeof summary).toBe(\"string\");\n    expect(summary.length).toBeGreaterThan(0);\n    expect(totalLines).toBe(600);\n  });\n\n  it(\"wraps Flash summary with path and line count header\", async () => {\n    vi.mock(\"../../src/adapters/factory.js\", () => ({\n      createTierAdapter: vi.fn().mockReturnValue({\n        client: { invoke: vi.fn().mockResolvedValue({ content: \"This file exports helpers.\" }), cache: null },\n      }),\n    }));\n\n    const longContent = \"export function helper() {}\\n\".repeat(600);\n    const { summary } = await summarizeFileWithFlash(\"src/helpers.ts\", longContent, CONFIG);\n    expect(summary).toContain(\"src/helpers.ts\");\n    expect(summary).toContain(\"lines\");\n    expect(summary).toContain(\"Flash summary\");\n  });\n});\n```\n\n---\n\n### 2. Edge Cases Missing in Existing Tests\n\n#### `adapters/factory.test.ts` — 4 gaps\n\n```typescript\n// Add to tests/adapters/factory.test.ts\n\nit(\"throws for unknown protocol\", () => {\n  const badConfig = { ...TEST_CONFIG, models: { ...TEST_CONFIG.models,\n    \"bad-proto\": { protocol: \"grpc\" as any, model: \"x\", baseUrl: \"http://x\", contextLimit: 1000, temperature: 0.2 },\n  }};\n  expect(() => createAdapter(\"bad-proto\", badConfig)).toThrow(/Unknown protocol/);\n});\n\nit(\"Anthropic uses 4096 default maxTokens when maxOutputTokens is not set\", () => {\n  const resolved = createAdapter(\"claude-opus\", TEST_CONFIG); // claude-opus has no maxOutputTokens\n  const client = resolved.client as any;\n  expect(client.maxTokens).toBe(4096);\n});\n\nit(\"Anthropic with non-anthropic baseUrl passes baseURL in clientOptions\", () => {\n  const proxyConfig: VoidRiftConfig = { ...TEST_CONFIG, models: { ...TEST_CONFIG.models,\n    \"claude-proxy\": { protocol: \"anthropic\", model: \"cla