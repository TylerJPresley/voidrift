stTokenAt\n    { content: \"real\" },   // first real content\n  ]);\n  const result = await streamModel(client, [], () => {});\n  expect(result.timing!.firstTokenAt).not.toBeNull();\n  expect(result.timing!.firstTokenAt).toBeGreaterThanOrEqual(result.timing!.requestStart);\n});\n```\n\n---\n\n#### `bootstrap/cleanup.test.ts` — 3 gaps\n\n```typescript\n// Add to tests/bootstrap/cleanup.test.ts\n\nit(\"treats corrupted .meta.json as no-meta and checks age\", () => {\n  const wtDir = join(TMP, \".voidrift\", \"worktrees\", \"corrupted\");\n  mkdirSync(wtDir, { recursive: true });\n  writeFileSync(join(wtDir, \".meta.json\"), \"{ invalid json !!!\");\n\n  const result = cleanupWorktrees(TMP);\n  // Newly created dir — age < 2h — should be preserved\n  expect(result.preservedWorktrees).toContain(\"corrupted\");\n});\n\nit(\"treats .meta.json with wrong field types as no-meta\", () => {\n  const wtDir = join(TMP, \".voidrift\", \"worktrees\", \"bad-types\");\n  mkdirSync(wtDir, { recursive: true });\n  writeFileSync(join(wtDir, \".meta.json\"), JSON.stringify({ pid: \"not-a-number\", createdAt: 12345 }));\n\n  const result = cleanupWorktrees(TMP);\n  expect(result.preservedWorktrees).toContain(\"bad-types\");\n});\n\nit(\"skips non-directory entries in the worktrees directory\", () => {\n  const worktreeDir = join(TMP, \".voidrift\", \"worktrees\");\n  writeFileSync(join(worktreeDir, \"stray-file.txt\"), \"not a dir\");\n\n  const result = cleanupWorktrees(TMP);\n  expect(result.prunedWorktrees).not.toContain(\"stray-file.txt\");\n  expect(result.preservedWorktrees).not.toContain(\"stray-file.txt\");\n});\n```\n\n---\n\n#### `events/bus.test.ts` — 2 gaps (completely untested API surface)\n\n```typescript\n// Add to tests/events/bus.test.ts\n\nit(\"registerEvent and listRegisteredEvents track custom event names\", () => {\n  const bus = new EventBus();\n  bus.registerEvent(\"MY_CUSTOM_EVENT\");\n  bus.registerEvent(\"ANOTHER_EVENT\");\n\n  const events = bus.listRegisteredEvents();\n  expect(events).toContain(\"MY_CUSTOM_EVENT\");\n  expect(events).toContain(\"ANOTHER_EVENT\");\n});\n\nit(\"does not duplicate registerEvent entries\", () => {\n  const bus = new EventBus();\n  bus.registerEvent(\"ONCE\");\n  bus.registerEvent(\"ONCE\");\n\n  const events = bus.listRegisteredEvents();\n  expect(events.filter((e) => e === \"ONCE\")).toHaveLength(1);\n});\n```\n\n---\n\n#### `codemap/cache.test.ts` — 2 gaps\n\n```typescript\n// Add to tests/codemap/cache.test.ts\n\nit(\"initializes to empty cache if index_cache.json contains invalid JSON\", () => {\n  const { writeFileSync, mkdirSync } = require(\"fs\");\n  const voidriftDir = join(TMP, \".voidrift\");\n  mkdirSync(voidriftDir, { recursive: true });\n  writeFileSync(join(voidriftDir, \"index_cache.json\"), \"{ broken json\");\n\n  const cache = new IndexCache(TMP);\n  const hash = cache.computeHash(\"anything\");\n  // Should not throw and should return null (clean state)\n  expect(cache.get(\"some/file.ts\", hash)).toBeNull();\n});\n\nit(\"stores lastIndexed as a numeric timestamp\", () => {\n  const cache = new IndexCache(TMP);\n  const before = Date.now();\n  const hash = cache.computeHash(\"content\");\n  cache.set(\"src/a.ts\", hash, \"summary\", 20);\n  const after = Date.now();\n\n  const entry = cache.get(\"src/a.ts\", hash);\n  expect(entry!.lastIndexed).toBeGreaterThanOrEqual(before);\n  expect(entry!.lastIndexed).toBeLessThanOrEqual(after);\n});\n```\n\n---\n\n#### `logging/audit.test.ts` — 4 missing event type logs\n\n```typescript\n// Add to tests/logging/audit.test.ts\n\nit(\"auto-logs BEFORE_TOOL_EXECUTE events\", async () => {\n  const bus = new EventBus();\n  const logger = makeLogger(\"tool-before\");\n  logger.attach(bus);\n\n  bus.publish(\"BEFORE_TOOL_EXECUTE\", { toolName: \"write_file\", arguments: { path: \"x.ts\" } });\n  await new Promise((r) => setTimeout(r, 20));\n\n  const entry = JSON.parse(readFileSync(logger.localLogPath, \"utf-8\").trim());\n  expect(entry.message).toContain(\"write_file\");\n});\n\nit(\"auto-logs AFTER_TOOL_EXECUTE events with status\", async () => {\n  const bus = new EventBus();\n  const logger = makeLogger(\"tool-after\");\n  logger.attach(bus);\n\n  bus.publish(\"AFTER_TOOL_EXECUTE\", { toolName: \"read_file\", arguments: {}, status: \"success\", output: \"file content\" });\n  await new Promise((r) => setTimeout(r, 20));\n\n  const entry = JSON.parse(readFileSync(logger.localLogPath, \"utf-8\").trim());\n  expect(entry.message).toContain(\"read_file\");\n});\n\nit(\"logModelResponse writes structured entry directly\", () => {\n  const logger = makeLogger(\"model-resp\");\n  logger.logModelResponse(\n    \"claude-3-5-sonnet\",\n    \"Here is the answer\",\n    [],\n    { promptTokens: 100, completionTokens: 20, totalTokens: 120 },\n    { requestStart: 1000, firstTokenAt: 1050, endAt: 1200 }\n  );\n\n  const entry = JSON.parse(readFileSync(logger.localLogPath, \"utf-8\").trim());\n  expect(entry.source).toBe(\"model\");\n  expect(entry.data.model).toBe(\"claude-3-5-sonnet\");\n  expect(entry.data.prefillMs).toBe(50);\n  expect(entry.data.totalMs).toBe(200);\n});\n\nit(\"auto-logs SESSION_START to global log\", async () => {\n  const bus = new EventBus();\n  const logger = makeLogger(\"session-start\");\n  logger.attach(bus);\n\n  bus.publish(\"SESSION_START\", { workspaceRoot: \"/home/user/project\", globalConfig: {} });\n  await new Promise((r) => setTimeout(r, 20));\n\n  const entry = JSON.parse(readFileSync(logger.globalLogPath, \"utf-8\").trim());\n  expect(entry.source).toBe(\"cli\");\n  expect(entry.message).toBe(\"session_start\");\n});\n```\n\n---\n\n### 3. Integration Test Gaps\n\n| Gap | Description |\n|---|---|\n| Config → Container | No test that `bootstrap()` plumbs a valid config into the returned container and that the container's `shutdown()` cleanly stops the watcher |\n| Credential → MCP connect | No test that a saved OAuth credential is loaded and injected as `Authorization` header when connecting an MCP server |\n| Cleanup → Container | No test that `cleanupWorktrees` errors (non-fatal) don't cause `bootstrap()` to throw |\n| Flash summarizer in codemap pipeline | No test that `IndexCache` hit prevents a second Flash call (cache layer + summarizer integration) |\n| Agent registry → validateAssets | No end-to-end test that core agents (chat, plan) pass validation with no issues |\n\n```typescript\n// tests/integration/flows.test.ts — add these describe blocks\n\ndescribe(\"Integration: bootstrap wires config into container\", () => {\n  it(\"bootstrap succeeds with valid config and shutdown cleans up\", async () => {\n    const configPath = join(TMP, \"boot-test\", \"config.json\");\n    mkdirSync(dirname(configPath), { recursive: true });\n    writeFileSync(configPath, JSON.stringify({\n      tiers: { flash: \"local\", utility: \"local\", dense: \"local\" },\n      models: { local: { protocol: \"openai\", model: \"test\", baseUrl: \"http://localhost:11434/v1\", contextLimit: 32768 } },\n    }));\n\n    const container = await bootstrap({ workspaceRoot: TMP, globalConfigPath: configPath, skipWatcher: true });\n    expect(container.config.tiers.flash).toBe(\"local\");\n    expect(container.bus).toBeDefined();\n    await expect(container.shutdown()).resolves.not.toThrow();\n  });\n});\n\ndescribe(\"Integration: core agents pass startup validation\", () => {\n  it(\"validateAssets returns no issues for default AgentRegistry and empty skill list\", () => {\n    const registry = new AgentRegistry();\n    const emptySkillManager = { indexed: [] } as any;\n    const issues = validateAssets(registry, emptySkillManager);\n    expect(issues).toHaveLength(0);\n  });\n});\n```\n\n---\n\n### Summary by Priority\n\n| Priority | Gap | Effort |\n|---|---|---|\n| **High** | `src/mcp/credentials.ts` — zero tests, crypto round-trip + refresh logic | Low (pure functions) |\n| **High** | `src/bootstrap/validate.ts` — zero tests, 3 distinct branches | Low |\n| **High** | `stream.ts` — pre-aborted signal path (silent data loss if broken) | Low |\n| **High** | `factory.ts` — unknown protocol throws (guards against bad config) | Trivial |\n| **Medium** | `src/adapters/cache.ts` — singleton contract | Trivial |\n| **Medium** | `mcp/discovery.ts` — pure helpers (`extractResourceMetadataUrl`, `buildConfigFromDiscovery`) | Low |\n| **Medium** | `events/bus.ts` — `registerEvent`/`listRegisteredEvents` fully untested | Low |\n| **Medium** | `codemap/summarizer.ts` — small-file shortcut and Flash fallback | Medium (mock needed) |\n| **Low** | `cleanup.ts` — corrupted meta/locks robustness | Low |\n| **Low** | `audit.ts` — `BEFORE/AFTER_TOOL_EXECUTE`, `SESSION_START`, `logModelResponse` | Low |\n",
