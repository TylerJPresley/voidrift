        "title": "`src/mcp/discovery.ts` — No test file",
        "content": "\n`discoverMCPServer` requires network calls, but `extractResourceMetadataUrl` and `buildConfigFromDiscovery` are pure and fully testable. The discovery function itself needs fetch mocking for error paths.\n\n```typescript\n// tests/mcp/discovery.test.ts\nimport { describe, it, expect, vi, afterEach } from \"vitest\";\nimport { discoverMCPServer, buildConfigFromDiscovery } from \"../../src/mcp/discovery.js\";\nimport type { MCPDiscoveryResult } from \"../../src/mcp/discovery.js\";\n\nafterEach(() => { vi.restoreAllMocks(); });\n\ndescribe(\"discoverMCPServer\", () => {\n  it(\"returns no-auth result when server responds without error\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue({\n      json: async () => ({ result: { protocolVersion: \"2024-11-05\", capabilities: {} } }),\n      ok: true,\n    }));\n\n    const result = await discoverMCPServer(\"http://localhost:9000\");\n    expect(result.requiresAuth).toBe(false);\n    expect(result.error).toBeUndefined();\n  });\n\n  it(\"records error when server returns non-auth error\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue({\n      json: async () => ({ error: { message: \"Internal Server Error\", data: {} } }),\n      ok: true,\n    }));\n\n    const result = await discoverMCPServer(\"http://localhost:9000\");\n    expect(result.error).toMatch(/Internal Server Error/);\n  });\n\n  it(\"captures discovery failure when fetch throws\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockRejectedValue(new Error(\"ECONNREFUSED\")));\n\n    const result = await discoverMCPServer(\"http://localhost:9001\");\n    expect(result.error).toMatch(/Discovery failed/);\n    expect(result.error).toContain(\"ECONNREFUSED\");\n  });\n\n  it(\"calls onStatus callback with progress messages\", async () => {\n    vi.stubGlobal(\"fetch\", vi.fn().mockResolvedValue({\n      json: async () => ({ result: { protocolVersion: \"2024-11-05\" } }),\n      ok: true,\n    }));\n\n    const statuses: string[] = [];\n    await discoverMCPServer(\"http://localhost:9000\", (msg) => statuses.push(msg));\n    expect(statuses.length).toBeGreaterThan(0);\n  });\n});\n\ndescribe(\"buildConfigFromDiscovery\", () => {\n  it(\"builds a basic http-sse config from no-auth discovery\", () => {\n    const discovery: MCPDiscoveryResult = {\n      url: \"http://localhost:9000\",\n      transport: \"http-sse\",\n      requiresAuth: false,\n    };\n    const config = buildConfigFromDiscovery(\"my-server\", discovery);\n    expect(config.transport).toBe(\"http-sse\");\n    expect(config.url).toBe(\"http://localhost:9000\");\n  });\n\n  it(\"includes auth config when discovery found OAuth\", () => {\n    const discovery: MCPDiscoveryResult = {\n      url: \"http://localhost:9000\",\n      transport: \"http-sse\",\n      requiresAuth: true,\n      authConfig: {\n        authorizeUrl: \"https://auth.example.com/authorize\",\n        tokenUrl: \"https://auth.example.com/token\",\n        scopes: [\"read\", \"write\"],\n      },\n    };\n    const config = buildConfigFromDiscovery(\"auth-server\", discovery);\n    expect(config).toMatchObject({\n      transport: \"http-sse\",\n      url: \"http://localhost:9000\",\n    });\n  });\n});\n```\n\n---\n\n",
        "level": 4
