        "language": "typescript",
        "code": "// tests/mcp/credentials.test.ts\nimport { describe, it, expect, afterEach } from \"vitest\";\nimport { saveCredential, loadCredential, deleteCredential, hasCredential, refreshIfNeeded } from \"../../src/mcp/credentials.js\";\nimport type { StoredCredential } from \"../../src/mcp/credentials.js\";\n\nconst TEST_SERVER = \"test-server-\" + Date.now();\n\nafterEach(() => {\n  deleteCredential(TEST_SERVER);\n});\n\nconst CRED: StoredCredential = {\n  accessToken: \"tok_abc123\",\n  refreshToken: \"ref_xyz789\",\n  tokenType: \"Bearer\",\n  scope: \"read write\",\n};\n\ndescribe(\"MCP Credential Store\", () => {\n  it(\"round-trips a credential through save and load\", () => {\n    saveCredential(TEST_SERVER, CRED);\n    const loaded = loadCredential(TEST_SERVER);\n    expect(loaded).not.toBeNull();\n    expect(loaded!.accessToken).toBe(\"tok_abc123\");\n    expect(loaded!.refreshToken).toBe(\"ref_xyz789\");\n    expect(loaded!.scope).toBe(\"read write\");\n  });\n\n  it(\"returns null for nonexistent server\", () => {\n    expect(loadCredential(\"server-that-does-not-exist\")).toBeNull();\n  });\n\n  it(\"hasCredential returns false before save, true after\", () => {\n    expect(hasCredential(TEST_SERVER)).toBe(false);\n    saveCredential(TEST_SERVER, CRED);\n    expect(hasCredential(TEST_SERVER)).toBe(true);\n  });\n\n  it(\"deleteCredential removes the credential file\", () => {\n    saveCredential(TEST_SERVER, CRED);\n    deleteCredential(TEST_SERVER);\n    expect(hasCredential(TEST_SERVER)).toBe(false);\n    expect(loadCredential(TEST_SERVER)).toBeNull();\n  });\n\n  it(\"deleteCredential is a no-op for nonexistent server\", () => {\n    expect(() => deleteCredential(\"never-existed-\" + Date.now())).not.toThrow();\n  });\n\n  it(\"overwrites existing credential on second save\", () => {\n    saveCredential(TEST_SERVER, CRED);\n    saveCredential(TEST_SERVER, { ...CRED, accessToken: \"tok_NEW\" });\n    const loaded = loadCredential(TEST_SERVER);\n    expect(loaded!.accessToken).toBe(\"tok_NEW\");\n  });\n});\n\ndescribe(\"refreshIfNeeded\", () => {\n  it(\"returns the credential unchanged when not expired\", async () => {\n    const cred: StoredCredential = {\n      accessToken: \"valid\",\n      expiresAt: Date.now() + 3600_000, // 1 hour from now\n    };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"http://unused.example.com\" } as any);\n    expect(result).toBe(cred); // same reference — no refresh\n  });\n\n  it(\"returns null when expired but no refreshToken\", async () => {\n    const cred: StoredCredential = {\n      accessToken: \"expired\",\n      expiresAt: Date.now() - 1000, // already expired\n    };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"http://unused.example.com\" } as any);\n    expect(result).toBeNull();\n  });\n\n  it(\"returns credential unchanged when expiresAt is undefined (no expiry)\", async () => {\n    const cred: StoredCredential = { accessToken: \"no-expiry\" };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"http://unused.example.com\" } as any);\n    expect(result).toBe(cred);\n  });\n});"
      },
