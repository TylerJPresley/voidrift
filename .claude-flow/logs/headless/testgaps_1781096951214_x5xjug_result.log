        "title": "`adapters/stream.test.ts` — 3 gaps",
        "content": "\n```typescript\n// Add to tests/adapters/stream.test.ts\n\nit(\"returns empty result immediately when signal is pre-aborted\", async () => {\n  const controller = new AbortController();\n  controller.abort(); // aborted BEFORE the call\n\n  const client = makeMockClient([{ content: \"should not appear\" }]);\n  const received: StreamChunk[] = [];\n  const result = await streamModel(client, [], (c) => received.push(c), controller.signal);\n\n  expect(result.text).toBe(\"\");\n  expect(result.toolCalls).toHaveLength(0);\n  expect(received).toHaveLength(0); // no onChunk calls at all\n});\n\nit(\"includes timing fields with valid requestStart and endAt\", async () => {\n  const before = Date.now();\n  const client = makeMockClient([{ content: \"hello\" }]);\n  const result = await streamModel(client, [], () => {});\n  const after = Date.now();\n\n  expect(result.timing).toBeDefined();\n  expect(result.timing!.requestStart).toBeGreaterThanOrEqual(before);\n  expect(result.timing!.endAt).toBeLessThanOrEqual(after);\n  expect(result.timing!.endAt).toBeGreaterThanOrEqual(result.timing!.requestStart);\n});\n\nit(\"sets firstTokenAt only after the first content chunk\", async () => {\n  const client = makeMockClient([\n    { content: \"\" },       // empty — should NOT set firstTokenAt\n    { content: \"real\" },   // first real content\n  ]);\n  const result = await streamModel(client, [], () => {});\n  expect(result.timing!.firstTokenAt).not.toBeNull();\n  expect(result.timing!.firstTokenAt).toBeGreaterThanOrEqual(result.timing!.requestStart);\n});\n```\n\n---\n\n",
