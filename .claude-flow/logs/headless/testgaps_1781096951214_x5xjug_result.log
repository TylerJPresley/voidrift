        "content": "\n```typescript\n// Add to tests/logging/audit.test.ts\n\nit(\"auto-logs BEFORE_TOOL_EXECUTE events\", async () => {\n  const bus = new EventBus();\n  const logger = makeLogger(\"tool-before\");\n  logger.attach(bus);\n\n  bus.publish(\"BEFORE_TOOL_EXECUTE\", { toolName: \"write_file\", arguments: { path: \"x.ts\" } });\n  await new Promise((r) => setTimeout(r, 20));\n\n  const entry = JSON.parse(readFileSync(logger.localLogPath, \"utf-8\").trim());\n  expect(entry.message).toContain(\"write_file\");\n});\n\nit(\"auto-logs AFTER_TOOL_EXECUTE events with status\", async () => {\n  const bus = new EventBus();\n  const logger = makeLogger(\"tool-after\");\n  logger.attach(bus);\n\n  bus.publish(\"AFTER_TOOL_EXECUTE\", { toolName: \"read_file\", arguments: {}, status: \"success\", output: \"file content\" });\n  await new Promise((r) => setTimeout(r, 20));\n\n  const entry = JSON.parse(readFileSync(logger.localLogPath, \"utf-8\").trim());\n  expect(entry.message).toContain(\"read_file\");\n});\n\nit(\"logModelResponse writes structured entry directly\", () => {\n  const logger = makeLogger(\"model-resp\");\n  logger.logModelResponse(\n    \"claude-3-5-sonnet\",\n    \"Here is the answer\",\n    [],\n    { promptTokens: 100, completionTokens: 20, totalTokens: 120 },\n    { requestStart: 1000, firstTokenAt: 1050, endAt: 1200 }\n  );\n\n  const entry = JSON.parse(readFileSync(logger.localLogPath, \"utf-8\").trim());\n  expect(entry.source).toBe(\"model\");\n  expect(entry.data.model).toBe(\"claude-3-5-sonnet\");\n  expect(entry.data.prefillMs).toBe(50);\n  expect(entry.data.totalMs).toBe(200);\n});\n\nit(\"auto-logs SESSION_START to global log\", async () => {\n  const bus = new EventBus();\n  const logger = makeLogger(\"session-start\");\n  logger.attach(bus);\n\n  bus.publish(\"SESSION_START\", { workspaceRoot: \"/home/user/project\", globalConfig: {} });\n  await new Promise((r) => setTimeout(r, 20));\n\n  const entry = JSON.parse(readFileSync(logger.globalLogPath, \"utf-8\").trim());\n  expect(entry.source).toBe(\"cli\");\n  expect(entry.message).toBe(\"session_start\");\n});\n```\n\n---\n\n",
