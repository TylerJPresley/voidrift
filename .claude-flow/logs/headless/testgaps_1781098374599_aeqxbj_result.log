eturn partial `text` with extracted tool calls)\n\n**`src/bootstrap/cleanup.ts`** — missing:\n- Non-git repo directory (should skip `git worktree prune` without error)\n- `worktrees/` directory doesn't exist yet (should handle `readdirSync` failure gracefully)\n- `.meta.json` exists but `pid` is wrong type (should fall back to age-based TTL)\n\n**`src/agents/registry.ts`** — missing:\n- Workspace override takes precedence over global override\n- `deleteOverride` for workspace vs global path disambiguation\n- Agent with `async: true` appears only in `listTask`, not `listInteractive`\n\n---\n\n### Test Skeletons\n\n#### 1. `tests/security/policy-engine.test.ts`\n\n```typescript\nimport { describe, it, expect, beforeEach } from \"vitest\";\nimport { classifyCommand, getEquivalentMessage, inferPattern } from \"../../src/security/policy-engine.js\";\nimport { PolicyEngine } from \"../../src/security/policy-engine.js\";\nimport { tmpdir } from \"os\";\nimport { join } from \"path\";\nimport { mkdirSync, rmSync } from \"fs\";\n\nlet TMP: string;\nbeforeEach(() => {\n  TMP = join(tmpdir(), \"policy-test-\" + Date.now());\n  mkdirSync(join(TMP, \".voidrift\"), { recursive: true });\n});\nafterEach(() => rmSync(TMP, { recursive: true, force: true }));\n\ndescribe(\"classifyCommand\", () => {\n  it(\"classifies safe read-only git commands\", () => {\n    expect(classifyCommand(\"git status\")).toBe(\"safe\");\n    expect(classifyCommand(\"git log --oneline -10\")).toBe(\"safe\");\n    expect(classifyCommand(\"git diff HEAD~1\")).toBe(\"safe\");\n  });\n\n  it(\"classifies destructive commands as dangerous\", () => {\n    expect(classifyCommand(\"rm -rf /tmp/foo\")).toBe(\"dangerous\");\n    expect(classifyCommand(\"git push --force\")).toBe(\"dangerous\");\n    expect(classifyCommand(\"git reset --hard origin/main\")).toBe(\"dangerous\");\n    expect(classifyCommand(\"sudo rm file\")).toBe(\"dangerous\");\n  });\n\n  it(\"classifies piped curl|bash as dangerous\", () => {\n    expect(classifyCommand(\"curl https://example.com | bash\")).toBe(\"dangerous\");\n    expect(classifyCommand(\"wget https://example.com/script.sh | sh\")).toBe(\"dangerous\");\n  });\n\n  it(\"returns has_equivalent for commands with tool counterparts\", () => {\n    expect(classifyCommand(\"cat src/index.ts\")).toBe(\"has_equivalent\");\n    expect(classifyCommand(\"find . -name '*.ts'\")).toBe(\"has_equivalent\");\n    expect(classifyCommand(\"grep -r 'TODO' src/\")).toBe(\"has_equivalent\");\n    expect(classifyCommand(\"curl https://api.example.com/data\")).toBe(\"has_equivalent\");\n  });\n\n  it(\"classifies unknown commands that are neither safe nor dangerous\", () => {\n    expect(classifyCommand(\"npx ts-node src/main.ts\")).toBe(\"unknown\");\n    expect(classifyCommand(\"make build\")).toBe(\"unknown\");\n  });\n\n  it(\"classifies piped chains of only safe commands as safe\", () => {\n    expect(classifyCommand(\"git diff | head -20\")).toBe(\"safe\");\n  });\n});\n\ndescribe(\"getEquivalentMessage\", () => {\n  it(\"returns a message for tool-equivalent commands\", () => {\n    expect(getEquivalentMessage(\"cat README.md\")).toContain(\"read_file\");\n    expect(getEquivalentMessage(\"find . -name '*.ts'\")).toContain(\"glob_files\");\n    expect(getEquivalentMessage(\"grep pattern file\")).toContain(\"search_content\");\n  });\n\n  it(\"returns undefined for non-equivalent commands\", () => {\n    expect(getEquivalentMessage(\"npm install\")).toBeUndefined();\n    expect(getEquivalentMessage(\"git status\")).toBeUndefined();\n  });\n});\n\ndescribe(\"PolicyEngine.check\", () => {\n  it(\"allows autonomous agents without asking\", () => {\n    const engine = new PolicyEngine(TMP);\n    const result = engine.check(\"execute_command\", { command: \"rm -rf /\" }, \"autonomous\");\n    expect(result.decision).toBe(\"allow\");\n  });\n\n  it(\"denies all tools in deny mode\", () => {\n    const engine = new PolicyEngine(TMP);\n    const result = engine.check(\"write_file\", { path: \"src/foo.ts\" }, \"deny\");\n    expect(result.decision).toBe(\"deny\");\n  });\n\n  it(\"allows explicitly allowed read-only tools in prompt mode\", () => {\n    const engine = new PolicyEngine(TMP);\n    const result = engine.check(\"read_file\", { path: \"src/index.ts\" }, \"prompt\");\n    expect(result.decision).toBe(\"allow\");\n  });\n\n  it(\"asks for write_file in prompt mode with no matching rule\", () => {\n    const engine = new PolicyEngine(TMP);\n    const result = engine.check(\"write_file\", { path: \"src/new.ts\" }, \"prompt\");\n    expect(result.decision).toBe(\"ask\");\n  });\n\n  it(\"session-scoped allow rule overrides default ask\", () => {\n    const engine = new PolicyEngine(TMP);\n    engine.addRule({ tool: \"write_file\", pattern: \"src/**\", decision: \"allow\", priority: 300, source: \"session\" });\n    const result = engine.check(\"write_file\", { path: \"src/new.ts\" }, \"prompt\");\n    expect(result.decision).toBe(\"allow\");\n  });\n\n  it(\"workspace rule (priority 200) loses to session rule (priority 300)\", () => {\n    const engine = new PolicyEngine(TMP);\n    engine.addRule({ tool: \"write_file\", pattern: \"src/**\", decision: \"deny\", priority: 200, source: \"workspace\" });\n    engine.addRule({ tool: \"write_file\", pattern: \"src/**\", decision: \"allow\", priority: 300, source: \"session\" });\n    const result = engine.check(\"write_file\", { path: \"src/new.ts\" }, \"prompt\");\n    expect(result.decision).toBe(\"allow\");\n  });\n});\n\ndescribe(\"inferPattern\", () => {\n  it(\"infers path glob from file tool args\", () => {\n    const pattern = inferPattern(\"write_file\", { path: \"src/session/brain.ts\" });\n    expect(pattern).toMatch(/src\\//);\n  });\n\n  it(\"infers command prefix from execute_command\", () => {\n    const pattern = inferPattern(\"execute_command\", { command: \"npm run build\" });\n    expect(pattern).toMatch(/npm/);\n  });\n});\n```\n\n#### 2. `tests/session/brain.test.ts`\n\n```typescript\nimport { describe, it, expect, beforeEach, afterEach, vi } from \"vitest\";\nimport { SessionBrain } from \"../../src/session/brain.js\";\nimport { EventBus } from \"../../src/events/bus.js\";\nimport { mkdirSync, rmSync, existsSync, readFileSync } from \"fs\";\nimport { join } from \"path\";\nimport { tmpdir } from \"os\";\n\nlet TMP: string;\nlet bus: EventBus;\n\nbeforeEach(() => {\n  TMP = join(tmpdir(), \"brain-test-\" + Date.now());\n  mkdirSync(TMP, { recursive: true });\n  bus = new EventBus();\n});\nafterEach(() => rmSync(TMP, { recursive: true, force: true }));\n\nfunction makeContext(overrides = {}) {\n  return {\n    agent: { activePersona: \"You are helpful.\", activeTools: [\"read_file\"], boundSkills: [], skillDiscoveryIndex: [], activeMemoryIndex: [] },\n    orbit: { activePlan: \"# Plan\\n- Step 1\", workspaceCodeMap: \"\", activeMemory: [], activeSkills: [] },\n    drift: { focusedFiles: [{ path: \"src/index.ts\", totalLines: 100, readRanges: [] }], gitStatus: null },\n    void: { messages: [{ role: \"user\", content: \"hello\" }], diagnostics: null, turnContext: [] },\n    ...overrides,\n  };\n}\n\ndescribe(\"SessionBrain.save / load\", () => {\n  it(\"persists all context partitions to disk\", () => {\n    const brain = new SessionBrain(TMP, \"abc123\", bus);\n    brain.save(makeContext() as any, \"chat\");\n\n    const sessionDir = join(TMP, \".voidrift\", \"sessions\", \"abc123\");\n    expect(existsSync(join(sessionDir, \"work.messages.json\"))).toBe(true);\n    expect(existsSync(join(sessionDir, \"workspace.plan.md\"))).toBe(true);\n    expect(existsSync(join(sessionDir, \"governance.persona.md\"))).toBe(true);\n  });\n\n  it(\"round-trips messages through save/load\", () => {\n    const brain = new SessionBrain(TMP, \"abc123\", bus);\n    brain.save(makeContext() as any, \"chat\");\n\n    const brain2 = new SessionBrain(TMP, \"abc123\", bus);\n    const loaded = brain2.load();\n    expect(loaded).not.toBeNull();\n    expect(loaded!.context.void?.messages).toEqual([{ role: \"user\", content: \"hello\" }]);\n  });\n\n  it(\"returns null when session directory does not exist\", () => {\n    const brain = new SessionBrain(TMP, \"nonexistent\", bus);\n    expect(brain.load()).toBeNull();\n  });\n\n  it(\"increments turnIndex on each save\", () => {\n    const brain = new SessionBrain(TMP, \"abc123\", bus);\n    brain.save(makeContext() as any, \"chat\");\n    brain.save(makeContext() as any, \"chat\");\n    expect(brain.turn).toBe(2);\n  });\n});\n\ndescribe(\"SessionBrain.attach\", () => {\n  it(\"increments turn and saves on TURN_COMPLETE\", () => {\n    const brain = new SessionBrain(TMP, \"sess1\", bus);\n    const ctx = makeContext() as any;\n    brain.attach(() => ctx, () => \"chat\");\n\n    bus.publish(\"TURN_COMPLETE\", { turnId: \"t1\" });\n    expect(brain.turn).toBe(1);\n    expect(existsSync(join(TMP, \".voidrift\", \"sessions\", \"sess1\", \"work.messages.json\"))).toBe(true);\n  });\n});\n\ndescribe(\"SessionBrain.listSessions\", () => {\n  it(\"returns empty array when no sessions exist\", () => {\n    const brain = new SessionBrain(TMP, \"sess-x\", bus);\n    expect(brain.listSessions()).toEqual([]);\n  });\n\n  it(\"lists all saved sessions sorted by last activity descending\", () => {\n    const b1 = new SessionBrain(TMP, \"old-sess\", bus);\n    b1.save(makeContext() as any, \"chat\");\n\n    // Small delay to ensure different timestamps\n    const b2 = new SessionBrain(TMP, \"new-sess\", bus);\n    b2.save(makeContext() as any, \"chat\");\n\n    const list = b2.listSessions();\n    expect(list.length).toBe(2);\n    expect(list[0].id).toBe(\"new-sess\"); // most recent first\n  });\n});\n\ndescribe(\"SessionBrain.loadSession\", () => {\n  it(\"restores messages and plan from another session\", () => {\n    const b1 = new SessionBrain(TMP, \"orig\", bus);\n    b1.save(makeContext({ void: { messages: [{ role: \"user\", content: \"original\" }], diagnostics: null, turnContext: [] } }) as any, \"chat\");\n\n    const b2 = new SessionBrain(TMP, \"current\", bus);\n    const mockCtx = { setMessages: vi.fn(), setPlan: vi.fn(), setDiagnostics: vi.fn() };\n    const ok = b2.loadSession(\"orig\", mockCtx);\n\n    expect(ok).toBe(true);\n    expect(mockCtx.setMessages).toHaveBeenCalledWith([{ role: \"user\", content: \"original\" }]);\n  });\n\n  it(\"returns false for nonexistent session id\", () => {\n    const brain = new SessionBrain(TMP, \"current\", bus);\n    const ok = brain.loadSession(\"does-not-exist\", { setMessages: vi.fn(), setPlan: vi.fn(), setDiagnostics: vi.fn() });\n    expect(ok).toBe(false);\n  });\n});\n```\n\n#### 3. `tests/safeguards/diff.test.ts`\n\n```typescript\nimport { describe, it, expect, beforeEach, afterEach } from \"vitest\";\nimport { computeDiff, computeEditDiff, getWorkspaceDiff } from \"../../src/safeguards/diff.js\";\nimport { writeFileSync, mkdirSync, rmSync } from \"fs\";\nimport { join } from \"path\";\nimport { tmpdir } from \"os\";\nimport { execSync } from \"child_process\";\n\nlet TMP: string;\n\nbeforeEach(() => {\n  TMP = join(tmpdir(), \"diff-test-\" + Date.now());\n  mkdirSync(TMP, { recursive: true });\n  execSync(\"git init\", { cwd: TMP, stdio: \"ignore\" });\n  execSync('git config user.email \"test@test.com\"', { cwd: TMP, stdio: \"ignore\" });\n  execSync('git config user.name \"Test\"', { cwd: TMP, stdio: \"ignore\" });\n});\nafterEach(() => rmSync(TMP, { recursive: true, force: true }));\n\ndescribe(\"computeDiff\", () => {\n  it(\"treats new files as all-addition lines\", () => {\n    const diff = computeDiff(TMP, \"new-file.ts\", \"line1\\nline2\");\n    expect(diff).toEqual([\"+line1\", \"+line2\"]);\n  });\n\n  it(\"marks removed lines with - and added with +\", () => {\n    writeFileSync(join(TMP, \"file.ts\"), \"line1\\nline2\\nline3\");\n    const diff = computeDiff(TMP, \"file.ts\", \"line1\\nlineX\\nline3\");\n    const joined = diff.join(\"\\n\");\n    expect(joined).toContain(\"-line2\");\n    expect(joined).toContain(\"+lineX\");\n    expect(joined).toContain(\" line1\");\n  });\n\n  it(\"shows no diff for identical content\", () => {\n    writeFileSync(join(TMP, \"same.ts\"), \"hello\");\n    const diff = computeDiff(TMP, \"same.ts\", \"hello\");\n    expect(diff.every(l => l.startsWith(\" \"))).toBe(true);\n  });\n});\n\ndescribe(\"computeEditDiff\", () => {\n  it(\"shows search/replace blocks as - and + lines\", () => {\n    writeFileSync(join(TMP, \"target.ts\"), \"const x = 1;\\nconst y = 2;\");\n    const diff = computeEditDiff(TMP, \"target.ts\", \"const x = 1;\", \"const x = 42;\");\n    expect(diff.some(l => l === \"-const x = 1;\")).toBe(true);\n    expect(diff.some(l => l === \"+const x = 42;\")).toBe(true);\n  });\n\n  it(\"returns error when file does not exist\", () => {\n    const diff = computeEditDiff(TMP, \"missing.ts\", \"old\", \"new\");\n    expect(diff[0]).toContain(\"not found\");\n  });\n\n  it(\"returns error when search block not found in file\", () => {\n    writeFileSync(join(TMP, \"file.ts\"), \"const x = 1;\");\n    const diff = computeEditDiff(TMP, \"file.ts\", \"const y = 99;\", \"const y = 0;\");\n    expect(diff[0]).toContain(\"not found\");\n  });\n});\n\ndescribe(\"getWorkspaceDiff\", () => {\n  it(\"returns empty string in a clean repo\", () => {\n    execSync(\"git commit --allow-empty -m 'init'\", { cwd: TMP, stdio: \"ignore\" });\n    expect(getWorkspaceDiff(TMP)).toBe(\"\");\n  });\n\n  it(\"returns non-empty string after a file modification\", () => {\n    execSync(\"git commit --allow-empty -m 'init'\", { cwd: TMP, stdio: \"ignore\" });\n    writeFileSync(join(TMP, \"tracked.ts\"), \"v1\");\n    execSync(\"git add tracked.ts\", { cwd: TMP, stdio: \"ignore\" });\n    execSync(\"git commit -m 'add file'\", { cwd: TMP, stdio: \"ignore\" });\n    writeFileSync(join(TMP, \"tracked.ts\"), \"v2\");\n    expect(getWorkspaceDiff(TMP)).toContain(\"tracked.ts\");\n  });\n\n  it(\"returns empty string for non-git directories\", () => {\n    const nonGit = join(TMP, \"non-git\");\n    mkdirSync(nonGit);\n    expect(getWorkspaceDiff(nonGit)).toBe(\"\");\n  });\n});\n```\n\n#### 4. `tests/orchestration/scheduler.test.ts`\n\n```typescript\nimport { describe, it, expect, beforeEach, afterEach, vi } from \"vitest\";\nimport { TaskScheduler, parseDelay } from \"../../src/orchestration/scheduler.js\";\nimport { EventBus } from \"../../src/events/bus.js\";\n\ndescribe(\"parseDelay\", () => {\n  it(\"parses seconds\", () => expect(parseDelay(\"30s\")).toBe(30_000));\n  it(\"parses minutes\", () => expect(parseDelay(\"15m\")).toBe(900_000));\n  it(\"parses hours\", () => expect(parseDelay(\"2h\")).toBe(7_200_000));\n  it(\"defaults to 60s for invalid format\", () => expect(parseDelay(\"bad\")).toBe(60_000));\n});\n\ndescribe(\"TaskScheduler\", () => {\n  let bus: EventBus;\n  let onFire: ReturnType<typeof vi.fn>;\n  let scheduler: TaskScheduler;\n\n  beforeEach(() => {\n    vi.useFakeTimers();\n    bus = new EventBus();\n    onFire = vi.fn();\n    scheduler = new TaskScheduler(bus, onFire);\n  });\n  afterEach(() => {\n    scheduler.cancelAll();\n    vi.useRealTimers();\n  });\n\n  describe(\"scheduleDelay\", () => {\n    it(\"fires once after the delay\", () => {\n      scheduler.scheduleDelay(5_000, \"do something\");\n      expect(onFire).not.toHaveBeenCalled();\n      vi.advanceTimersByTime(5_000);\n      expect(onFire).toHaveBeenCalledOnce();\n      expect(onFire).toHaveBeenCalledWith(\"do something\");\n    });\n\n    it(\"does not fire again after firing\", () => {\n      scheduler.scheduleDelay(1_000, \"once\");\n      vi.advanceTimersByTime(10_000);\n      expect(onFire).toHaveBeenCalledOnce();\n    });\n\n    it(\"marks task as fired after execution\", () => {\n      const task = scheduler.scheduleDelay(1_000, \"done\");\n      vi.advanceTimersByTime(1_000);\n      expect(task.status).toBe(\"fired\");\n    });\n  });\n\n  describe(\"scheduleCron\", () => {\n    it(\"fires repeatedly on interval (*/5 * * * *)\", () => {\n      scheduler.scheduleCron(\"*/5 * * * *\", \"tick\");\n      vi.advanceTimersByTime(5 * 60_000);\n      expect(onFire).toHaveBeenCalledOnce();\n      vi.advanceTimersByTime(5 * 60_000);\n      expect(onFire).toHaveBeenCalledTimes(2);\n    });\n\n    it(\"parses */N hour pattern\", () => {\n      const task = scheduler.scheduleCron(\"0 */2 * * *\", \"biHourly\");\n      vi.advanceTimersByTime(2 * 60 * 60_000);\n      expect(onFire).toHaveBeenCalledOnce();\n    });\n\n    it(\"defaults to 30min for invalid cron\", () => {\n      const task = scheduler.scheduleCron(\"bad pattern\", \"fallback\");\n      expect(task.type).toBe(\"cron\");\n      vi.advanceTimersByTime(30 * 60_000);\n      expect(onFire).toHaveBeenCalledOnce();\n    });\n  });\n\n  describe(\"cancel\", () => {\n    it(\"cancels a delay task before it fires\", () => {\n      const task = scheduler.scheduleDelay(5_000, \"should not fire\");\n      expect(scheduler.cancel(task.id)).toBe(true);\n      vi.advanceTimersByTime(10_000);\n      expect(onFire).not.toHaveBeenCalled();\n      expect(task.status).toBe(\"cancelled\");\n    });\n\n    it(\"returns false for unknown task id\", () => {\n      expect(scheduler.cancel(\"nonexistent\")).toBe(false);\n    });\n\n    it(\"excludes cancelled tasks from active list\", () => {\n      const t1 = scheduler.scheduleDelay(1_000, \"a\");\n      const t2 = scheduler.scheduleDelay(2_000, \"b\");\n      scheduler.cancel(t1.id);\n      expect(scheduler.active.map(t => t.id)).not.toContain(t1.id);\n      expect(scheduler.active.map(t => t.id)).toContain(t2.id);\n    });\n  });\n\n  describe(\"cancelAll\", () => {\n    it(\"cancels all active tasks and prevents firing\", () => {\n      scheduler.scheduleDelay(1_000, \"a\");\n      scheduler.scheduleDelay(2_000, \"b\");\n      scheduler.cancelAll();\n      vi.advanceTimersByTime(10_000);\n      expect(onFire).not.toHaveBeenCalled();\n      expect(scheduler.active).toHaveLength(0);\n    });\n  });\n});\n```\n\n#### 5. `tests/mcp/credentials.test.ts`\n\n```typescript\nimport { describe, it, expect, beforeEach, afterEach } from \"vitest\";\nimport { saveCredential, loadCredential, deleteCredential, hasCredential } from \"../../src/mcp/credentials.js\";\nimport { rmSync, mkdirSync } from \"fs\";\nimport { join } from \"path\";\nimport { tmpdir } from \"os\";\n\n// Patch CRED_DIR to a tmp path to avoid touching user's real credentials\nconst REAL_HOME = process.env.HOME!;\nlet TMP: string;\n\nbeforeEach(() => {\n  TMP = join(tmpdir(), \"cred-test-\" + Date.now());\n  mkdirSync(TMP, { recursive: true });\n  // Override HOME so saveCredential writes to TMP\n  process.env.HOME = TMP;\n});\nafterEach(() => {\n  process.env.HOME = REAL_HOME;\n  rmSync(TMP, { recursive: true, force: true });\n});\n\ndescribe(\"saveCredential / loadCredential\", () => {\n  it(\"round-trips credentials through encrypt/decrypt\", () => {\n    const cred = { accessToken: \"tok_abc\", refreshToken: \"ref_xyz\", expiresAt: Date.now() + 3600_000 };\n    saveCredential(\"test-server\", cred);\n    const loaded = loadCredential(\"test-server\");\n    expect(loaded).toEqual(cred);\n  });\n\n  it(\"returns null for unknown server\", () => {\n    expect(loadCredential(\"no-such-server\")).toBeNull();\n  });\n\n  it(\"encrypts the stored file (not plaintext)\", () => {\n    saveCredential(\"enc-server\", { accessToken: \"secret\" });\n    const { readFileSync } = await import(\"fs\");\n    const { homedir } = await import(\"os\");\n    const raw = readFileSync(join(homedir(), \".config\", \"voidrift\", \"credentials\", \"enc-server.json\"), \"utf-8\");\n    expect(raw).not.toContain(\"secret\");\n    expect(raw).toContain('\"iv\"');\n    expect(raw).toContain('\"data\"');\n  });\n});\n\ndescribe(\"hasCredential / deleteCredential\", () => {\n  it(\"returns false when credential does not exist\", () => {\n    expect(hasCredential(\"ghost\")).toBe(false);\n  });\n\n  it(\"returns true after saving\", () => {\n    saveCredential(\"present\", { accessToken: \"x\" });\n    expect(hasCredential(\"present\")).toBe(true);\n  });\n\n  it(\"returns false after deletion\", () => {\n    saveCredential(\"gone\", { accessToken: \"y\" });\n    deleteCredential(\"gone\");\n    expect(hasCredential(\"gone\")).toBe(false);\n    expect(loadCredential(\"gone\")).toBeNull();\n  });\n});\n\ndescribe(\"refreshIfNeeded\", () => {\n  it(\"returns credential as-is when not expired\", async () => {\n    const { refreshIfNeeded } = await import(\"../../src/mcp/credentials.js\");\n    const cred = { accessToken: \"valid\", expiresAt: Date.now() + 3600_000 };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"https://example.com/token\", authorizeUrl: \"\" } as any);\n    expect(result).toEqual(cred);\n  });\n\n  it(\"returns null when expired and no refresh token\", async () => {\n    const { refreshIfNeeded } = await import(\"../../src/mcp/credentials.js\");\n    const cred = { accessToken: \"expired\", expiresAt: Date.now() - 1000 };\n    const result = await refreshIfNeeded(cred, { tokenUrl: \"https://example.com/token\", authorizeUrl: \"\" } as any);\n    expect(result).toBeNull();\n  });\n});\n```\n\n#### 6. `tests/bootstrap/validate.test.ts`\n\n```typescript\nimport { describe, it, expect } from \"vitest\";\nimport { validateAssets } from \"../../src/bootstrap/validate.js\";\nimport type { AgentRegistry } from \"../../src/agents/registry.js\";\nimport type { SkillManager } from \"../../src/skills/manager.js\";\n\nfunction makeAgents(ids: string[]): Partial<AgentRegistry> {\n  return {\n    listInteractive: () => ids.slice(0, 2).map(id => ({ id } as any)),\n    listTask: () => ids.slice(2).map(id => ({ id } as any)),\n  };\n}\n\nfunction makeSkills(overrides: any[] = []): Partial<SkillManager> {\n  return { indexed: overrides };\n}\n\ndescribe(\"validateAssets\", () => {\n  it(\"returns no issues for valid skills with known agents\", () => {\n    const agents = makeAgents([\"chat\", \"plan\"]);\n    const skills = makeSkills([\n      { name: \"mySkill\", description: \"does stuff\", agents: [\"chat\"], filePath: \"/skills/my.md\" },\n    ]);\n    // We can't easily test filePath reads without real files — skip fs-dependent path\n    // At minimum, confirm it doesn't throw\n    expect(() => validateAssets(agents as any, skills as any)).not.toThrow();\n  });\n\n  it(\"reports issue for skill referencing nonexistent agent\", () => {\n    const agents = makeAgents([\"chat\"]);\n    const skills = makeSkills([\n      { name: \"badSkill\", description: \"bad\", agents: [\"ghost-agent\"], filePath: \"/skills/bad.md\" },\n    ]);\n    const issues = validateAssets(agents as any, skills as any);\n    const issue = issues.find(i => i.id === \"badSkill\");\n    expect(issue).toBeDefined();\n    expect(issue!.message).toContain(\"ghost-agent\");\n  });\n\n  it(\"reports issue for skill missing name\", () => {\n    const agents = makeAgents([\"chat\"]);\n    const skills = makeSkills([\n      { name: \"\", description: \"desc\", agents: [], filePath: \"/skills/unnamed.md\" },\n    ]);\n    const issues = validateAssets(agents as any, skills as any);\n    expect(issues.some(i => i.message.includes(\"name\"))).toBe(true);\n  });\n\n  it(\"returns empty array when skills list is empty\", () => {\n    const agents = makeAgents([\"chat\"]);\n    const skills = makeSkills([]);\n    expect(validateAssets(agents as any, skills as any)).toEqual([]);\n  });\n});\n```\n\n#### 7. `tests/codemap/summarizer.test.ts`\n\n```typescript\nimport { describe, it, expect, vi, beforeEach } from \"vitest\";\nimport { summarizeFileWithFlash } from \"../../src/codemap/summarizer.js\";\nimport type { VoidRiftConfig } from \"../../src/config/loader.js\";\n\nconst BASE_CONFIG: VoidRiftConfig = {\n  tiers: { flash: \"local\", utility: \"local\", dense: \"local\" },\n  models: { local: { protocol: \"openai\", model: \"test\", baseUrl: \"http://localhost:11434/v1\", contextLimit: 32768, temperature: 0.2 } },\n  summarizeThreshold: 5,\n  maxReadLines: 1000,\n  maxConcurrentAgents: 1,\n  plugins: [],\n  search: { provider: \"duckduckgo\" },\n  tracing: { enabled: false, apiKeyEnv: \"\", project: \"test\" },\n};\n\ndescribe(\"summarizeFileWithFlash\", () => {\n  it(\"returns full content for files under the summarizeThreshold\", async () => {\n    const content = \"line1\\nline2\\nline3\";\n    const result = await summarizeFileWithFlash(\"src/small.ts\", content, BASE_CONFIG);\n    expect(result.summary).toBe(content);\n    expect(result.totalLines).toBe(3);\n  });\n\n  it(\"falls back to structural summary when Flash model call fails\", async () => {\n    // Config points to a non-reachable endpoint — Flash call will throw\n    const longContent = Array.from({ length: 50 }, (_, i) => `export function fn${i}() {}`).join(\"\\n\");\n    const result = await summarizeFileWithFlash(\"src/big.ts\", longContent, {\n      ...BASE_CONFIG,\n      summarizeThreshold: 5,\n    });\n    // Should return something (structural fallback), not throw\n    expect(result.summary).toBeTruthy();\n    expect(result.totalLines).toBe(50);\n  });\n\n  it(\"reports correct totalLines regardless of summary source\", async () => {\n    const content = \"a\\nb\\nc\\nd\\ne\\nf\";\n    const result = await summarizeFileWithFlash(\"src/x.ts\", content, { ...BASE_CONFIG, summarizeThreshold: 3 });\n    expect(result.totalLines).toBe(6);\n  });\n});\n```\n\n#### 8. Missing edge cases for `tests/config/loader.test.ts`\n\n```typescript\n// Add these describes to the existing loader test file\n\ndescribe(\"loadConfig — API key resolution edge cases\", () => {\n  it(\"resolves apiKeyEnv from process.env\", () => {\n    process.env.MY_API_KEY = \"sk-test123\";\n    writeFileSync(globalPath, JSON.stringify({\n      ...BASE_CONFIG_RAW,\n      models: {\n        \"test-model\": { ...BASE_MODEL, apiKeyEnv: \"MY_API_KEY\" },\n      },\n    }));\n    const config = loadConfig({ globalConfigPath: globalPath });\n    // apiKeyEnv should remain set; the actual key is resolved inside the factory\n    expect(config.models[\"test-model\"].apiKeyEnv).toBe(\"MY_API_KEY\");\n    delete process.env.MY_API_KEY;\n  });\n\n  it(\"throws when local config has invalid JSON\", () => {\n    writeFileSync(join(TMP, \".voidrift\", \"config.json\"), \"{ invalid json }\");\n    expect(() => loadConfig({ globalConfigPath: globalPath, workspaceRoot: TMP })).toThrow(/Failed to parse JSON/);\n  });\n\n  it(\"deep-merges local config without overwriting unset global keys\", () => {\n    writeFileSync(join(TMP, \".voidrift\", \"config.json\"), JSON.stringify({\n      summarizeThreshold: 999,\n    }));\n    const config = loadConfig({ globalConfigPath: globalPath, workspaceRoot: TMP });\n    expect(config.summarizeThreshold).toBe(999);\n    // Tiers from global should still be present\n    expect(config.tiers.flash).toBeDefined();\n  });\n});\n\ndescribe(\"loadConfig — tier validation\", () => {\n  it(\"throws when a tier references a model not in models block\", () => {\n    writeFileSync(globalPath, JSON.stringify({\n      ...BASE_CONFIG_RAW,\n      tiers: { flash: \"nonexistent\", utility: \"default-local\", dense: \"default-local\" },\n    }));\n    expect(() => loadConfig({ globalConfigPath: globalPath })).toThrow(/tier/);\n  });\n});\n```\n\n---\n\n### Integration Test Gaps (`tests/integration/flows.test.ts`)\n\nThe existing integration test covers the chat→tool→response flow but is missing:\n\n```typescript\n// Add to flows.test.ts\n\ndescribe(\"session persistence and recovery\", () => {\n  it(\"recovers conversation history after simulated crash (brain.load)\", async () => {\n    // 1. Run a turn, save via brain\n    // 2. Create a new brain with same sessionId\n    // 3. Call brain.load() and assert messages are restored\n  });\n});\n\ndescribe(\"policy engine integration with turn execution\", () => {\n  it(\"blocks write_file in deny mode even with explicit request\", async () => {\n    // Create engine with deny-mode agent\n    // Submit message that requests file write\n    // Assert tool is blocked and user sees deny message\n  });\n});\n\ndescribe(\"scheduler → turn execution integration\", () => {\n  it(\"fires scheduled instruction and runs it as a new turn\", async () => {\n    // Schedule a 100ms delay\n    // Advance timers\n    // Assert onFire was called with instruction\n  });\n});\n```\n\n---\n\n### Summary\n\n**Highest-value gaps to close first:**\n\n1. **`policy-engine.ts`** — `classifyCommand` and `PolicyEngine.check` sit on every tool execution. The dangerous pattern regexes and glob matching are untested.\n2. **`session/brain.ts`** — crash recovery depends entirely on this; zero tests means a regression could silently break `/resume`.\n3. **`safeguards/diff.ts`** + **`checkpoint.ts`** — the rewind/rollback UX has no test coverage; a broken `computeDiff` would show wrong diffs in the approval gate.\n4. **`orchestration/scheduler.ts`** — `parseCronToMs` logic has five branches and no tests; a wrong interval would silently misfire.\n5. **`mcp/credentials.ts`** — cryptographic storage with no tests; a padding/IV bug would silently fail to load tokens.\n",
