{
  "name": "voidrift",
  "version": "0.4.0",
  "description": "VoidRift CLI — the terminal agent harness on the VoidRift core SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "voidrift": "./dist/cli.js"
  },
  "files": [
    "dist",
    "docs",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "gen:docs": "npm run build && node scripts/gen-docs.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest --run",
    "coverage": "vitest --run --coverage",
    "lint": "eslint src"
  },
  "dependencies": {
    "@voidrift/core": "^0.1.0",
    "chalk": "6.0.1",
    "ink": "8.0.0",
    "react": "19.3.0",
    "react-devtools-core": "8.0.0"
  },
  "devDependencies": {
    "@langchain/core": "1.2.17",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "ink-testing-library": "4.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "zod": "4.6.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "typescript-eslint": "8.71.1"
  },
  "voidrift": {
    "kind": "product"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerJPresley/voidrift.git"
  },
  "bugs": {
    "url": "https://github.com/TylerJPresley/voidrift/issues"
  },
  "homepage": "https://github.com/TylerJPresley/voidrift#readme",
  "keywords": [
    "voidrift",
    "cli",
    "terminal",
    "agent",
    "harness"
  ]
}
