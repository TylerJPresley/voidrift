    "react-devtools-core": "8.0.0"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "ink-testing-library": "4.0.0",
    "typescript": "5.9.3",
    "vitest": "5.0.3",
    "zod": "4.6.5"
  },
  "voidrift": {
    "kind": "product"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TylerJPresley/voidrift.git"
