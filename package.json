{
  "name": "voidrift",
  "version": "0.4.0",
  "description": "VoidRift CLI — the terminal agent harness on the VoidRift core SDK.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bin": {
